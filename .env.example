# PostgreSQL pooled connection string from Neon for the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct connection string for Prisma schema operations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"

# Google PageSpeed Insights API key. The service can be called without a key at low volume,
# but a key is recommended. Configure it at https://console.cloud.google.com/
PAGESPEED_API_KEY=""

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Defaults to OpenRouter's free-model router. Overrides must end in :free.
OPENROUTER_MODEL="openrouter/free"

# Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Try the first provider, then automatically fall back to the next one.
# Either provider can be listed first. Both keys enable failover in either direction.
AI_PROVIDER_ORDER="openrouter,gemini"

# Local development only. Vercel assigns its own function port and serves the
# frontend and API from one origin, so these are not needed in Vercel settings.
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
