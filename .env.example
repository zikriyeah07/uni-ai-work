# Google PageSpeed Insights API key. The service can be called without a key at low volume,
# but a key is recommended. Configure it at https://console.cloud.google.com/
PAGESPEED_API_KEY=""

# OpenCode Zen/Go API key (used by all three AI tools)
OPENCODE_API_KEY=""
# Default OpenCode chat-completions model; override if your key/model differs.
OPENCODE_MODEL="big-pickle"
# Base URL for OpenCode's OpenAI-compatible API. Use https://opencode.ai/zen/go/v1 for Go subscriptions.
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Defaults to OpenRouter's free-model router. Overrides must end in :free.
OPENROUTER_MODEL="openrouter/free"

# Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Try providers in order and fall back to the next configured one.
AI_PROVIDER_ORDER="opencode,openrouter,gemini"

# Local development only. Vercel assigns its own function port and serves the
# frontend and API from one origin, so these are not needed in Vercel settings.
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
